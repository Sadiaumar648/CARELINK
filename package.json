{
  "name": "carelink",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "carelink-backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace carelink-backend",
    "build:backend": "npm run build --workspace carelink-backend",
    "test:backend": "npm run test --workspace carelink-backend",
    "typecheck:backend": "npm run typecheck --workspace carelink-backend",
    "lint:backend": "npm run lint --workspace carelink-backend",
    "prepare": "node -e \"if(!process.env.VERCEL && !process.env.CI){try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}}\""
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "carelink-backend/**/*.{ts,tsx}": [
      "npm run lint --workspace carelink-backend -- --fix",
      "prettier --write"
    ],
    "packages/shared/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
